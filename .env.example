# BioAccess configuration. Copy to .env (git-ignored) and fill in the secrets you need.
# Every external service has a free fake/console mode; the defaults below need no accounts.

# --- Core ------------------------------------------------------------------------------
POSTGRES_USER=bioaccess
POSTGRES_PASSWORD=bioaccess
POSTGRES_DB=bioaccess
DATABASE_URL=postgresql+psycopg://bioaccess:bioaccess@localhost:5432/bioaccess
# At least 32 chars. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173    # comma-separated browser origins allowed to call the API
FRONTEND_URL=http://localhost:5173    # where the payment page sends users back
AUTH_RATE_LIMIT=10/minute             # login/register, per client IP
GATE_RATE_LIMIT=120/minute            # gate verify (face + QR), per gatekeeper
MAX_UPLOAD_MB=2

# --- Face recognition ------------------------------------------------------------------
FACE_PROVIDER=fake                    # fake (tests) | demo (webcam demo, NOT real recognition) | rekognition
# DEMO_FACES_FILE=backend/.demo_faces.json   # demo provider state (ids only); default shown
# DEMO_FACE_CHECK=true                 # demo provider rejects photos/frames without exactly one face; false if a dim room fools it
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=                    # IAM user with Rekognition (+ that S3 bucket) permissions only
AWS_SECRET_ACCESS_KEY=
FACE_MATCH_THRESHOLD=95               # similarity %, overridable by admins (80-100)
GATE_OPENS_MINUTES_BEFORE=60          # gates accept entries this long before starts_at

# --- Payments --------------------------------------------------------------------------
PAYMENT_PROVIDER=fake                 # fake | stripe
STRIPE_SECRET_KEY=                    # Stripe dashboard (test mode) > Developers > API keys: sk_test_...
STRIPE_WEBHOOK_SECRET=                # printed by: stripe listen --print-secret (whsec_...)

# --- Notifications ---------------------------------------------------------------------
EMAIL_PROVIDER=console                # console | resend
SMS_PROVIDER=console                  # console | twilio
# Without a verified domain Resend only sends from this address to your own signup email.
EMAIL_FROM=BioAccess <onboarding@resend.dev>
RESEND_API_KEY=                       # resend.com > API keys: re_...
TWILIO_ACCOUNT_SID=                   # twilio.com console (trial: verified numbers only)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # your Twilio number, e.g. +15005550006

# --- Storage (event cover images; never face images) -------------------------------------
STORAGE_PROVIDER=local                # local | s3
# LOCAL_MEDIA_DIR=backend/media       # local storage folder; default shown
S3_BUCKET=

# --- Docker stack only (docker compose up --build) -------------------------------------
PUBLIC_URL=https://localhost          # the address people open; https://<LAN-IP> for other devices
HTTPS_PORT=443
HTTP_PORT=80
