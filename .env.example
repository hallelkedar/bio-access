POSTGRES_USER=bioaccess
POSTGRES_PASSWORD=bioaccess
POSTGRES_DB=bioaccess

DATABASE_URL=postgresql+psycopg://bioaccess:bioaccess@localhost:5432/bioaccess
# At least 32 chars. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=https://localhost:5173
FRONTEND_URL=https://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=2

FACE_PROVIDER=fake            # fake | rekognition
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_MATCH_THRESHOLD=95
GATE_OPENS_MINUTES_BEFORE=60   # gates accept entries this long before starts_at

PAYMENT_PROVIDER=fake         # fake | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_PROVIDER=console        # console | resend
SMS_PROVIDER=console          # console | twilio
# Without a verified domain Resend only sends from this address to your own signup email.
EMAIL_FROM=BioAccess <onboarding@resend.dev>
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

STORAGE_PROVIDER=local        # local | s3
API_PUBLIC_URL=http://localhost:8000
S3_BUCKET=
